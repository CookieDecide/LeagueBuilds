{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LeagueBuilds Desktop",
  "version": "0.7.7",
  "identifier": "org.leaguebuilds.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LeagueBuilds Desktop",
        "width": 1200,
        "height": 980,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
